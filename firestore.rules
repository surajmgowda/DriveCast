rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidVideoEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.uriString is string && data.uriString.size() >= 1 && data.uriString.size() <= 1024 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 255 &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 86400000 &&
             data.lastPositionMs is int && data.lastPositionMs >= 0 && data.lastPositionMs <= 86400000 &&
             data.audioTrackIndex is int && data.audioTrackIndex >= -1 && data.audioTrackIndex <= 64 &&
             data.subtitleTrackIndex is int && data.subtitleTrackIndex >= -1 && data.subtitleTrackIndex <= 64 &&
             (data.playbackSpeed is int || data.playbackSpeed is float) && data.playbackSpeed >= 0.25 && data.playbackSpeed <= 4.0 &&
             data.aspectMode in ['FIT', 'FILL', 'ZOOM'] &&
             data.cachedOffline is bool &&
             data.mimeType is string && data.mimeType.size() <= 100 &&
             data.resolutionLabel is string && data.resolutionLabel.size() <= 50 &&
             data.audioDelayMs is int && data.audioDelayMs >= -1000 && data.audioDelayMs <= 1000;
    }

    function isValidEqPreset(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.bandLevelsMb is list && data.bandLevelsMb.size() >= 1 && data.bandLevelsMb.size() <= 10 &&
             data.bandLevelsMb[0] is int &&
             data.bassBoostStrength is int && data.bassBoostStrength >= 0 && data.bassBoostStrength <= 1000 &&
             data.loudnessGainMb is int && data.loudnessGainMb >= 0 && data.loudnessGainMb <= 1500 &&
             data.activePreset is bool;
    }

    function isValidSettings(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.qualityProfile in ['AUTO_ADAPTIVE', 'USB_C_1080P60', 'WIRELESS_720P60', 'THERMAL_SAFE_720P30'] &&
             data.autoResume is bool &&
             data.offlineCacheLimitMb is int && data.offlineCacheLimitMb >= 256 && data.offlineCacheLimitMb <= 16384 &&
             data.preferredTransport in ['AUTO', 'ANDROID_AUTO_SURFACE', 'USB_C_DISPLAY', 'PHONE_ONLY'] &&
             data.parkedOnlyEnforced is bool && data.parkedOnlyEnforced == true;
    }

    function isValidPlaylist(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.videoIds is list && data.videoIds.size() <= 100 &&
             (data.videoIds.size() == 0 || (data.videoIds[0] is string && data.videoIds[0].size() >= 1 && data.videoIds[0].size() <= 128));
    }

    match /users/{userId}/videos/{videoId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(videoId);

      allow create: if isOwner(userId) &&
                       isValidId(videoId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'uriString', 'displayName', 'durationMs', 'lastPositionMs',
                         'audioTrackIndex', 'subtitleTrackIndex', 'playbackSpeed', 'aspectMode',
                         'cachedOffline', 'mimeType', 'resolutionLabel', 'audioDelayMs',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'uriString', 'displayName', 'durationMs', 'lastPositionMs',
                         'audioTrackIndex', 'subtitleTrackIndex', 'playbackSpeed', 'aspectMode',
                         'cachedOffline', 'mimeType', 'resolutionLabel', 'audioDelayMs',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidVideoEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidVideoEntry(incoming()) &&
                       request.auth.uid == userId &&
                       isValidId(videoId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         // Action: Update playback progress & tracks
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'lastPositionMs', 'audioTrackIndex', 'subtitleTrackIndex',
                           'playbackSpeed', 'aspectMode', 'audioDelayMs', 'updatedAt'
                         ]) ||
                         // Action: Update offline cache flag or metadata
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cachedOffline', 'displayName', 'durationMs', 'mimeType',
                           'resolutionLabel', 'updatedAt'
                         ]) ||
                         // Action: Full metadata upsert preserving userId & createdAt
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'uriString', 'displayName', 'durationMs', 'lastPositionMs',
                           'audioTrackIndex', 'subtitleTrackIndex', 'playbackSpeed', 'aspectMode',
                           'cachedOffline', 'mimeType', 'resolutionLabel', 'audioDelayMs', 'updatedAt'
                         ])
                       );
    }

    match /users/{userId}/eq_presets/{presetId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(presetId);

      allow create: if isOwner(userId) &&
                       isValidId(presetId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'bandLevelsMb', 'bassBoostStrength',
                         'loudnessGainMb', 'activePreset', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'bandLevelsMb', 'bassBoostStrength',
                         'loudnessGainMb', 'activePreset', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidEqPreset(incoming());

      allow update: if isSignedIn() &&
                       isValidEqPreset(incoming()) &&
                       request.auth.uid == userId &&
                       isValidId(presetId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         // Action: Activate/deactivate preset
                         incoming().diff(existing()).affectedKeys().hasOnly(['activePreset', 'updatedAt']) ||
                         // Action: Tune EQ bands and audio FX
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'bandLevelsMb', 'bassBoostStrength', 'loudnessGainMb',
                           'activePreset', 'updatedAt'
                         ])
                       );
    }

    match /users/{userId}/settings/{settingId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(settingId);

      allow create: if isOwner(userId) &&
                       isValidId(settingId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'qualityProfile', 'autoResume', 'offlineCacheLimitMb',
                         'preferredTransport', 'parkedOnlyEnforced', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'qualityProfile', 'autoResume', 'offlineCacheLimitMb',
                         'preferredTransport', 'parkedOnlyEnforced', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidSettings(incoming());

      allow update: if isSignedIn() &&
                       isValidSettings(incoming()) &&
                       request.auth.uid == userId &&
                       isValidId(settingId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'qualityProfile', 'autoResume', 'offlineCacheLimitMb',
                         'preferredTransport', 'parkedOnlyEnforced', 'updatedAt'
                       ]);
    }

    match /users/{userId}/playlists/{playlistId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(playlistId);

      allow create: if isOwner(userId) &&
                       isValidId(playlistId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'videoIds', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'videoIds', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidPlaylist(incoming());

      allow update: if isSignedIn() &&
                       isValidPlaylist(incoming()) &&
                       request.auth.uid == userId &&
                       isValidId(playlistId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'videoIds', 'updatedAt'
                       ]);
    }
  }
}
